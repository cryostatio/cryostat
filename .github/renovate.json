{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigestsToSemver",
    "docker:pinDigests",
    ":configMigration",
    ":docker",
    ":separateMajorReleases",
    ":separateMultipleMinorReleases",
    ":separatePatchReleases"
  ],
  "baseBranchPatterns": ["main", "/^cryostat-v.*/"],
  "reviewersFromCodeOwners": true,
  "labels": [
    "dependencies",
    "chore",
    "safe-to-test"
  ],
  "stopUpdatingLabel": "blocked",
  "semanticCommits": "enabled",
  "major": {
    "dependencyDashboardApproval": true
  },
  "minor": {
    "dependencyDashboardApproval": true
  },
  "git-submodules": {
      "enabled": true
  },
  "packageRules": [
    {
      "description": "Dockerfile base image updates are never gated by the dependency dashboard, on any branch",
      "matchManagers": ["dockerfile"],
      "dependencyDashboardApproval": false
    },
    {
      "description": "Disable all dependency updates on release branches except the cryostat-web submodule and Dockerfile base images; other updates there are handled via Mergify backport",
      "matchBaseBranches": ["/^cryostat-v.*/"],
      "enabled": false
    },
    {
      "description": "Allow the cryostat-web submodule to update on release branches, tracking the matching cryostat-web release branch",
      "matchBaseBranches": ["/^cryostat-v.*/"],
      "matchManagers": ["git-submodules"],
      "enabled": true
    },
    {
      "description": "Allow Dockerfile base image updates on release branches",
      "matchBaseBranches": ["/^cryostat-v.*/"],
      "matchManagers": ["dockerfile"],
      "enabled": true
    },
    {
      "description": "Require approval for Quarkus major and minor version updates",
      "matchManagers": [
        "maven"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "dependencyDashboardApproval": true,
      "matchPackageNames": [
        "/^io\\.quarkus:/",
        "/^io\\.quarkus\\.platform:/"
      ]
    },
    {
      "description": "Create PR for Quarkus patch version updates",
      "matchManagers": [
        "maven"
      ],
      "matchUpdateTypes": [
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "rollback",
        "bump",
        "replacement"
      ],
      "prCreation": "immediate",
      "matchPackageNames": [
        "/^io\\.quarkus:/",
        "/^io\\.quarkus\\.platform:/"
      ]
    },
    {
      "description": "Require approval for projectnessie updates",
      "matchManagers": [
        "maven"
      ],
      "dependencyDashboardApproval": true,
      "matchPackageNames": [
        "/^org\\.projectnessie\\.cel:/"
      ]
    },
    {
      "description": "Require approval for protobuf updates",
      "matchManagers": [
        "maven"
      ],
      "dependencyDashboardApproval": true,
      "matchPackageNames": [
        "/^com\\.google\\.protobuf:/"
      ]
    },
    {
      "description": "jfr-analytics is published only via JitPack and does not exist on Maven Central. Looking it up there normally yields a harmless 404, but when Maven Central responds 429 the uncached miss raises an external host error that aborts the entire Renovate run.",
      "matchManagers": [
        "maven"
      ],
      "matchPackageNames": [
        "com.github.moditect:jfr-analytics"
      ],
      "registryUrls": [
        "https://jitpack.io"
      ]
    }
  ]
}
