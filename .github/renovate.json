{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigestsToSemver",
    "docker:pinDigests",
    ":configMigration",
    ":docker",
    ":separateMajorReleases",
    ":separateMultipleMinorReleases",
    ":separatePatchReleases"
  ],
  "reviewersFromCodeOwners": true,
  "labels": [
    "dependencies",
    "chore",
    "safe-to-test"
  ],
  "stopUpdatingLabel": "blocked",
  "semanticCommits": "enabled",
  "major": {
    "dependencyDashboardApproval": true
  },
  "minor": {
    "dependencyDashboardApproval": true
  },
  "git-submodules": {
      "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the pinned tonistiigi/binfmt QEMU image passed to docker/setup-qemu-action, independently of the action's own pinned digest",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "image:\\s+mirror\\.gcr\\.io/tonistiigi/binfmt:(?<currentValue>qemu-v[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "depNameTemplate": "tonistiigi/binfmt",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^qemu-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Require approval for Quarkus major and minor version updates",
      "matchManagers": [
        "maven"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "dependencyDashboardApproval": true,
      "matchPackageNames": [
        "/^io\\.quarkus:/",
        "/^io\\.quarkus\\.platform:/"
      ]
    },
    {
      "description": "Create PR for Quarkus patch version updates",
      "matchManagers": [
        "maven"
      ],
      "matchUpdateTypes": [
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "rollback",
        "bump",
        "replacement"
      ],
      "prCreation": "immediate",
      "matchPackageNames": [
        "/^io\\.quarkus:/",
        "/^io\\.quarkus\\.platform:/"
      ]
    },
    {
      "description": "Require approval for projectnessie updates",
      "matchManagers": [
        "maven"
      ],
      "dependencyDashboardApproval": true,
      "matchPackageNames": [
        "/^org\\.projectnessie\\.cel:/"
      ]
    },
    {
      "description": "Require approval for protobuf updates",
      "matchManagers": [
        "maven"
      ],
      "dependencyDashboardApproval": true,
      "matchPackageNames": [
        "/^com\\.google\\.protobuf:/"
      ]
    },
    {
      "description": "jfr-analytics is published only via JitPack and does not exist on Maven Central. Looking it up there normally yields a harmless 404, but when Maven Central responds 429 the uncached miss raises an external host error that aborts the entire Renovate run.",
      "matchManagers": [
        "maven"
      ],
      "matchPackageNames": [
        "com.github.moditect:jfr-analytics"
      ],
      "registryUrls": [
        "https://jitpack.io"
      ]
    }
  ]
}
